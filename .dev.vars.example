# Copy to .dev.vars (git-ignored) for `wrangler pages dev` local development.
# These are read by functions/ via `context.env` — see .env.example for what
# each one is for.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=orders@avernic.uk
ADMIN_NOTIFICATION_EMAIL=
FENA_API_BASE_URL=
FENA_INTEGRATION_ID=
FENA_SECRET_KEY=
FENA_BANK_ACCOUNT_ID=
FENA_WEBHOOK_SHARED_SECRET=
SITE_URL=http://localhost:5173

# Secret salt for the cookieless analytics visitor hash (see README -> Analytics).
# Use a long random string. Without it, a publicly-known fallback salt is used.
ANALYTICS_SALT=change-me-to-a-long-random-string
