# ============================================================================
# Avernic UK — environment variables
#
# Copy this file to .env (for Vite, local frontend) AND configure the same
# server-side secrets in your Cloudflare Pages project settings (or
# `wrangler.toml` [vars] / `wrangler secret put` for local Pages Functions
# development). NEVER commit a real .env file.
#
# Variables prefixed VITE_ are exposed to the browser bundle — only ever put
# PUBLIC values there (a Supabase anon key is safe to expose; RLS enforces
# access control server-side). Everything else below is server-only and must
# only be read inside functions/ (Cloudflare Pages Functions), never imported
# from src/.
# ============================================================================

# --- Supabase (public, browser-safe) ---------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Supabase (server-only, Cloudflare Pages Functions) ---------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (server-only) ----------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=orders@avernic.uk
ADMIN_NOTIFICATION_EMAIL=

# --- Fena Open Banking (server-only) -----------------------------------------
# From the Fena dashboard: Settings -> API keys -> Generate API Key (role
# "Owner"/"Partner Integration"). The generated "Terminal ID"/"Terminal
# Secret" pair is what goes in FENA_INTEGRATION_ID/FENA_SECRET_KEY below —
# Fena's docs, SDKs and dashboard all use slightly different names for the
# same two values. See functions/_lib/fena.ts for the integration boundary
# and README.md "Fena integration status".
FENA_API_BASE_URL=
FENA_INTEGRATION_ID=
FENA_SECRET_KEY=
# Optional — only needed if more than one bank account is ever connected to
# this terminal; with just one, Fena uses it automatically (confirmed live).
FENA_BANK_ACCOUNT_ID=
# Optional but recommended: a random shared secret appended as ?key=... to
# the webhook notification URL configured in the Fena dashboard, so this
# endpoint ignores traffic that doesn't know it. See functions/api/payments/fena/webhook.ts.
FENA_WEBHOOK_SHARED_SECRET=

# --- App -----------------------------------------------------------------
VITE_SITE_URL=https://avernic.uk
SITE_URL=https://avernic.uk

# Secret salt for the cookieless analytics visitor hash (see README -> Analytics).
# Server-only. Use a long random string; never expose this to the browser.
ANALYTICS_SALT=change-me-to-a-long-random-string
